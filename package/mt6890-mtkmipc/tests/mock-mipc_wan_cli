#!/bin/sh
# Test stub for mipc_wan_cli (installed as "mipc_wan_cli" on a test PATH).
#   MOCK_MIPC_LOG   file receiving one line per call: args joined by " | "
#   MOCK_MIPC_ACT   ok (default) | fail   -> --data_call_act result
#   MOCK_MIPC_CID   cid returned on success (default 3)
#   MOCK_MIPC_SIM   --show_sim_status reply (default MIPC_SIM_STATUS_COMPLETE_READY)
#   MOCK_MIPC_PROV  --apn_provision_by_sim reply (default {})
#   MOCK_MIPC_HANG  non-empty: hang like the real CLI with the MIPC server
#                   down (`sleep 300`, exec'd so the watchdog's kill of this
#                   pid really ends it); pid written to MOCK_MIPC_HANG_PIDS
#   MOCK_MIPC_RADIO ON (default) | OFF -> --nw_radio_state_get state;
#                   MOCK_MIPC_RADIO_FILE, if it exists, overrides it

log="${MOCK_MIPC_LOG:-/dev/null}"
line=
for a in "$@"; do
	line="${line:+$line | }$a"
done
echo "$line" >> "$log"

if [ -n "${MOCK_MIPC_HANG:-}" ]; then
	echo "$$" >> "${MOCK_MIPC_HANG_PIDS:-/dev/null}"
	exec sleep 300
fi

case "$1" in
--nw_radio_state_get)
	radio="${MOCK_MIPC_RADIO:-ON}"
	[ -n "${MOCK_MIPC_RADIO_FILE:-}" ] && [ -f "$MOCK_MIPC_RADIO_FILE" ] && \
		radio="$(cat "$MOCK_MIPC_RADIO_FILE")"
	echo "Get SW radio state:MIPC_NW_RADIO_STATE_$radio" ;;
--nw_radio_state_set)
	echo "OK" ;;
--show_sim_status)
	echo "${MOCK_MIPC_SIM:-MIPC_SIM_STATUS_COMPLETE_READY}" ;;
--check_nw_status)
	echo "MIPC_NW_REGISTERED_HOME" ;;
--apn_provision_by_sim)
	echo "${MOCK_MIPC_PROV:-{\}}" ;;
--check_ia|--data_call_deact|--data_call_deact_apn|--get_imei)
	echo "OK" ;;
--data_call_act)
	if [ "${MOCK_MIPC_ACT:-ok}" = ok ]; then
		cat <<EOF
{"result":0,"cid":${MOCK_MIPC_CID:-3},"ifname":"ccmni${MOCK_MIPC_CID:-3}","v4_addr":"10.20.30.40","v4_mask":"255.255.255.255","v4_gw":"10.20.30.1","v4_dns1":"94.200.200.200","v4_dns2":"94.200.200.201","v4_mtu":1500,"v6_addr":"2001:db8:1:2::10","v6_prefix":64,"v6_gw":"fe80::1","v6_dns1":"2001:db8::53","v6_dns2":"","v6_mtu":1500,"clatd":"","odu_addr":"","odu_dhcp_offset":""}
EOF
	else
		echo '{"result":-1}'
	fi ;;
*)
	echo "mock-mipc_wan_cli: unknown command $1" >&2
	exit 1 ;;
esac
exit 0
