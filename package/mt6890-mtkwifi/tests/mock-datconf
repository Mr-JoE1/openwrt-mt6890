#!/bin/sh
# Mock of the stock datconf CLI surface used by mtwifi.sh:
#   datconf -f <dat> set <KEY> <VALUE>
# Records argv (one line, fields joined by '|') to $MOCK_DATCONF_LOG and
# applies the change to the (synthetic) .dat so later reads see it.
printf '%s' "datconf" >> "$MOCK_DATCONF_LOG"
for a in "$@"; do printf '|%s' "$a" >> "$MOCK_DATCONF_LOG"; done
echo >> "$MOCK_DATCONF_LOG"

[ "$1" = "-f" ] && [ "$3" = "set" ] && [ $# -eq 5 ] || { echo "mock-datconf: bad usage" >&2; exit 2; }
f="$2" k="$4" v="$5"
[ -f "$f" ] || { echo "failed to open $f" >&2; exit 1; }
if grep -q "^$k=" "$f"; then
	awk -v k="$k" -v v="$v" 'index($0, k "=") == 1 { print k "=" v; next } { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
else
	echo "$k=$v" >> "$f"
fi
