# mt6890-mtkwifi defaults (issue #1): the MT7915 DBDC is driven by the
# vendor Lua wifi stack (X28-lineage /sbin/wifi, package vendor-mtwifi-fw);
# /etc/init.d/mt6890-wifi brings both bands up at boot (`wifi up`).
#
# These wifi-device sections register the two radios with netifd so the
# LuCI Wireless page can manage them through the "mtwifi" driver
# (/lib/netifd/wireless/mtwifi.sh): creating/editing an AP there maps onto
# the per-band .dat profiles via the stock `datconf` and re-bounces the
# band with the stock `/sbin/wifi down|up`. No interfaces are defined by
# default, so until you create one in LuCI the boot behaviour stays exactly
# the stock vendor path (open APs, SSIDs from the .dat profiles).
#
# The image ships no WPA key (open APs). To set one outside LuCI:
#   datconf -f /etc/wireless/mediatek/mt7915.dbdc.b0.dat set AuthMode WPA2PSK
#   datconf -f /etc/wireless/mediatek/mt7915.dbdc.b0.dat set WPAPSK1 '<key>'
#   (repeat for mt7915.dbdc.b1.dat)
#   wifi reload
config wifi-device 'wifidev0'
	option type 'mtwifi'
	option main_ifname 'ra0'

config wifi-device 'wifidev1'
	option type 'mtwifi'
	option main_ifname 'rai0'
