#!/bin/sh
# mock ubiattach -m N -d D: fake sysfs if the mtd backing file is UBI
echo "ubiattach $*" >> "$MOCK_LOG"
while [ $# -gt 0 ]; do case "$1" in -m) m="$2"; shift 2 ;; -d) d="$2"; shift 2 ;; *) shift ;; esac; done
[ "$(head -c 4 "$MOCK_DEV/mtd$m")" = "UBI#" ] || exit 1
mkdir -p "$MT6890_SYSUBI/ubi$d" "$MT6890_SYSUBI/ubi${d}_0" "$MT6890_SYSUBI/ubi${d}_1"
echo rootfs > "$MT6890_SYSUBI/ubi${d}_0/name"
echo rootfs_data > "$MT6890_SYSUBI/ubi${d}_1/name"
: > "$MOCK_DEV/ubi${d}_1"
