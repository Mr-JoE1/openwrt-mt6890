#!/bin/sh
# mock OpenWrt mtd: erase <part> | write - <part>; backing file $MOCK_DEV/mtdN
echo "mtd $*" >> "$MOCK_LOG"
num() { sed -n "s/^mtd\([0-9]*\): [0-9a-f]* [0-9a-f]* \"$1\"\$/\1/p" "$MT6890_PROC_MTD"; }
case "$1" in
erase) n="$(num "$2")"; [ -n "$n" ] || exit 1
	sz=$(wc -c < "$MOCK_DEV/mtd$n"); tr '\000' '\377' < /dev/zero | head -c "$sz" > "$MOCK_DEV/mtd$n" ;;
write) [ "$2" = - ] || exit 1; n="$(num "$3")"; [ -n "$n" ] || exit 1
	dd of="$MOCK_DEV/mtd$n" conv=notrunc bs=65536 2>/dev/null ;;
*) exit 1 ;;
esac
