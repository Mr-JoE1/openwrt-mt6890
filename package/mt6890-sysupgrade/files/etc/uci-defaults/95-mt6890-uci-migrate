#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Stock (19.07 / Quectel) -> 24.10 UCI migration for the DWR-2000M A3.
# 24.10 convention: /etc/uci-defaults runs once per first boot, after
# preinit has restored sysupgrade.tgz (lib/preinit/80_mount_root:39-43)
# and after 11_network-migrate-bridges (lan type/ifname -> device).
# Idempotent: every step checks before it rewrites.
#
#   network  proto ql_mipc -> mtkmipc; vlan -> pdn (PDN index, P3);
#            ifname 'ccmni' dropped (mtkmipc is no_device); mode kept only
#            if 1|2 (stock had 'AUTO' = invalid int for netifd);
#            apn/auth/username/password/iptype/roamingtype/ia*/rattype/plmn/
#            mtu/auto_conf/retry/bearer_bitmask kept as-is (same names).
#            Options mtkmipc does not know are left in place and logged.
#   stoneoim dropped (stock web UI state; no 24.10 consumer), sections logged
#   wireless kept as installed by mt6890-mtkwifi: a restored stock file
#            (no 'mtwifi' wifi-device) is moved aside and /rom's restored.
# Log: $MIGRATE_LOG (default /etc/mt6890-uci-migrate.log) + syslog.

UCI="${MT6890_UCI:-uci}"
CONF="${MT6890_UCI_CONF:-/etc/config}"
ROM_CONF="${MT6890_ROM_CONF:-/rom/etc/config}"
MIGRATE_LOG="${MIGRATE_LOG:-/etc/mt6890-uci-migrate.log}"

u() { $UCI -c "$CONF" "$@"; }

log() {
	echo "$*" >> "$MIGRATE_LOG"
	command -v logger >/dev/null 2>&1 && [ -z "${MT6890_UCI_CONF:-}" ] && logger -t mt6890-migrate "$*"
	return 0
}

MTKMIPC_OPTS=" proto apn auth username password iptype roamingtype iaapn iaiptype iaroamingtype rattype plmn mtu auto_conf retry bearer_bitmask iabearer_bitmask mode pdn sim metric disabled auto defaultroute peerdns dns ip6assign ipv6 force_link "

migrate_network() {
	[ -f "$CONF/network" ] || return 0
	local s opt val n=0
	for s in $(u -q show network | sed -n "s/^network\.\([^.=]*\)\.proto='ql_mipc'\$/\1/p"); do
		log "network.$s: proto ql_mipc -> mtkmipc"
		u set "network.$s.proto=mtkmipc"
		val="$(u -q get "network.$s.vlan")"
		if [ -n "$val" ]; then
			if [ -z "$(u -q get "network.$s.pdn")" ]; then
				u set "network.$s.pdn=$val"
				log "network.$s: vlan '$val' -> pdn '$val'"
			fi
			u delete "network.$s.vlan"
		fi
		val="$(u -q get "network.$s.ifname")"
		if [ -n "$val" ]; then
			u delete "network.$s.ifname"
			log "network.$s: dropped ifname '$val' (mtkmipc gets the ccmni device from the modem)"
		fi
		val="$(u -q get "network.$s.mode")"
		case "$val" in
		''|1|2) ;;
		*) u delete "network.$s.mode"; log "network.$s: dropped mode '$val' (mtkmipc: 1=route, 2=bridge; default 1)" ;;
		esac
		for opt in $(u -q show "network.$s" | sed -n "s/^network\.$s\.\([^=]*\)=.*/\1/p"); do
			case "$MTKMIPC_OPTS" in
			*" $opt "*) ;;
			*) log "network.$s: option '$opt' is not used by mtkmipc (left in place)" ;;
			esac
		done
		n=$((n + 1))
	done
	if [ "$n" -gt 0 ]; then
		u commit network
	fi
}

drop_stoneoim() {
	[ -f "$CONF/stoneoim" ] || return 0
	local secs
	secs="$(u -q show stoneoim | sed -n "s/^stoneoim\.\([^.=]*\)=\(.*\)/\1(\2)/p" | tr '\n' ' ')"
	log "stoneoim: dropped package (stock UI state, no 24.10 consumer): ${secs% }"
	rm -f "$CONF/stoneoim"
}

keep_wireless() {
	[ -f "$CONF/wireless" ] || return 0
	if u -q show wireless | grep -q "^wireless\.[^.]*\.type='mtwifi'\$"; then
		return 0
	fi
	if [ -f "$ROM_CONF/wireless" ]; then
		mv -f "$CONF/wireless" "$CONF/wireless.stock-migrated"
		cp -f "$ROM_CONF/wireless" "$CONF/wireless"
		log "wireless: stock config (no mtwifi radio) moved to wireless.stock-migrated; mt6890-mtkwifi default restored"
	else
		log "wireless: stock config has no mtwifi radio and no $ROM_CONF/wireless to restore - left as is"
	fi
}

note_firewall() {
	[ -f "$CONF/firewall" ] || return 0
	if u -q show firewall | grep -q "^firewall\.@include\[[0-9]*\]\.path='/etc/firewall.user'\$"; then
		u -q show firewall | grep -q "fw4_compatible='1'" || \
			log "firewall: legacy include /etc/firewall.user is ignored by fw4 (not fw4_compatible) - left in place"
	fi
}

migrate_network
drop_stoneoim
keep_wireless
note_firewall
exit 0
