#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Network defaults from stock UCI (evidence/uci-full.txt) and DTB
# (gsw@0 "mediatek,mt753x" portmap "llllw", CPU port 5). PORTING-ANALYSIS §6.4.
#
# Stock: switch0 vlan N = port (N-1) + 5t, vid N, for N=1..4;
#        lan bridge = eth0.1 eth0.2 (eth0.3/eth0.4 exist but are unused).
# Port labels / role of eth1 / port 4 ('w' in llllw): UNVERIFIED (P0).

. /lib/functions/uci-defaults.sh

# ucidef_add_switch merges all "lan"-role ports into ONE vlan. Rewrite the
# generated roles array so each LAN port gets its own vlan (stock layout).
# config_generate emits one switch_vlan per roles[] entry: vlan=<index>,
# ports=<ports>; swconfig defaults vid to the vlan number (stock vid 1..4).
mt6890_per_port_vlans() {
	local sw="$1" cpu="$2" n

	json_select switch
	json_select "$sw"
	json_select roles
	json_select 1
	json_add_string ports "0 $cpu"
	json_add_string device "eth0.1"
	json_select ..
	for n in 2 3 4; do
		json_add_object
		json_add_string role "lan"
		json_add_string ports "$((n - 1)) $cpu"
		json_add_string device "eth0.$n"
		json_close_object
	done
	json_select ..
	json_select ..
	json_select ..
}

board=$(board_name)

board_config_update

case "$board" in
dlink,dwr-2000m-a3|\
mediatek,evb6890v1_64_cpe_nand)
	ucidef_add_switch "switch0" \
		"0:lan:1" "1:lan:2" "2:lan:3" "3:lan:4" "5t@eth0"
	mt6890_per_port_vlans "switch0" "5t"
	# stock: network.lan.ifname='eth0.1 eth0.2'
	ucidef_set_interface_lan "eth0.1 eth0.2"
	# Cellular WAN. "mtkmipc" is a PLACEHOLDER: the real proto handler
	# (netifd-proto-mtkmipc) lands in P3. config_generate only writes
	# interfaces that have a device and only knows static/dhcp/pppoe/
	# ncm/qmi/mbim, so this entry does not yet produce network.wan; P3
	# ships a uci-defaults that creates it (and migrates stock ql_mipc).
	ucidef_set_interface "wan" protocol "mtkmipc"
	;;
esac

board_config_flush

exit 0
