#!/bin/sh /etc/rc.common
# Periodic LED state updater. Stock drove SIM/cellular/wifi LEDs from
# cpe-daemon; 24.10 does not run cpe-daemon. This replaces the subset
# drivable from verified public CLI verbs only.
START=96
STOP=5
USE_PROCD=1

start_service() {
	procd_open_instance leds
	procd_set_param command /bin/sh -c "while :; do /lib/mt6890/leds-update.sh; sleep 30; done"
	procd_set_param file /lib/mt6890/leds-update.sh
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	set_state shutdown
}
