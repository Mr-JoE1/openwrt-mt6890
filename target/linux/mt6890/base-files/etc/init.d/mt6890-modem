#!/bin/sh /etc/rc.common
# Start the vendor modem userspace stack in stock order (stock init.d:
# 1nvram_daemon -> 2ccci_fsd -> 3ccci_mdinit). With the MIPC service up,
# the netifd proto "mtkmipc" (package/mt6890-mtkmipc) can place data calls.
START=01
STOP=99
USE_PROCD=1

# v3.1.1 item 6: gated, watchdogged radio-on one-shot (replaces the blind
# `sleep 25; radio_state_set 1`). mipc_wan_cli has no timeout and hangs
# forever when the MIPC server is down, so every call goes through the 8 s
# probe() watchdog (live-proven pattern, verbatim). Sequence:
#   1. wait for MIPC: probe --show_sim_status until it answers
#      (any MIPC_SIM_STATUS_* reply), up to ~90 s total
#   2. --nw_radio_state_set 1
#   3. verify with --nw_radio_state_get 0 (expect MIPC_NW_RADIO_STATE_ON)
# Always exits 0 (procd one-shot; never blocks boot). POSIX sh (busybox).
# MT6890_RADIO_WAIT is a test knob only. Kept as text: it is the procd
# one-shot's `sh -c` body.
RADIO_ON_SH='PATH=$PATH:/usr/bin:/usr/sbin
probe() {
  ( "$@" >/tmp/.g_out 2>&1 & gp=$!; sleep 8; kill $gp >/dev/null 2>&1
    wait $gp >/dev/null 2>&1 )
  out=$(cat /tmp/.g_out 2>/dev/null)
}
wait_s="${MT6890_RADIO_WAIT:-90}"
waited=0 up=
while [ "$waited" -lt "$wait_s" ]; do
	probe mipc_wan_cli --show_sim_status
	waited=$((waited + 8))
	case "$out" in
	*MIPC_SIM_STATUS_*) up=1; break ;;
	esac
done
if [ -z "$up" ]; then
	logger -t mt6890-modem "radio_on: MIPC not answering after ${waited}s; radio not set"
	exit 0
fi
sim=$(echo "$out" | sed -n "s/.*\(MIPC_SIM_STATUS_[A-Z_]*\).*/\1/p" | head -n1)
logger -t mt6890-modem "radio_on: MIPC up after ${waited}s (sim: $sim)"
probe mipc_wan_cli --nw_radio_state_set 1
probe mipc_wan_cli --nw_radio_state_get 0
case "$out" in
*MIPC_NW_RADIO_STATE_ON*)
	logger -t mt6890-modem "radio_on: radio state ON" ;;
*)
	logger -t mt6890-modem "radio_on: radio not confirmed ON (got: $out)" ;;
esac
exit 0'

start_service() {
	procd_open_instance nvram_daemon
	procd_set_param command /usr/bin/nvram_daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance ccci_fsd
	procd_set_param command /usr/bin/ccci_fsd 0 2 0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance ccci_mdinit
	procd_set_param command /usr/bin/ccci_mdinit 0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# stock 85/99 daemons completing the MIPC userland (their absence is
	# the prime suspect for mipc_wan_cli segfaulting on 24.10)
	procd_open_instance ql_ril_service
	procd_set_param command /usr/bin/ql_ril_service
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance mipc_submonitor
	procd_set_param command /usr/bin/mipc_submonitor
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# one-shot after the stack is up: turn the cellular radio on (stock:
	# mipc_wan.init, START=99, `mipc_wan_cli --nw_radio_state_set 1`),
	# gated on MIPC answering (see RADIO_ON_SH above)
	procd_open_instance radio_on
	procd_set_param command /bin/sh -c "$RADIO_ON_SH"
	procd_set_param exit 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
