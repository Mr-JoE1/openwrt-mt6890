#!/bin/sh /etc/rc.common
# Start the vendor modem userspace stack in stock order (stock init.d:
# 1nvram_daemon -> 2ccci_fsd -> 3ccci_mdinit). With the MIPC service up,
# the netifd proto "mtkmipc" (package/mt6890-mtkmipc) can place data calls.
START=01
STOP=99
USE_PROCD=1

start_service() {
	procd_open_instance nvram_daemon
	procd_set_param command /usr/bin/nvram_daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance ccci_fsd
	procd_set_param command /usr/bin/ccci_fsd 0 2 0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance ccci_mdinit
	procd_set_param command /usr/bin/ccci_mdinit 0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# stock 85/99 daemons completing the MIPC userland (their absence is
	# the prime suspect for mipc_wan_cli segfaulting on 24.10)
	procd_open_instance ql_ril_service
	procd_set_param command /usr/bin/ql_ril_service
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance mipc_submonitor
	procd_set_param command /usr/bin/mipc_submonitor
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# one-shot after the stack is up: turn the cellular radio on (stock:
	# mipc_wan.init, START=99, `mipc_wan_cli --nw_radio_state_set 1`)
	procd_open_instance radio_on
	procd_set_param command /bin/sh -c "sleep 25; /usr/bin/mipc_wan_cli --nw_radio_state_set 1"
	procd_set_param exit 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
