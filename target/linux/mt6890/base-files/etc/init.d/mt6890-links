#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Create name-based MTD links from /proc/mtd (replaces stock setup_link.sh,
# which hard-codes mtd numbers):
#   /dev/mtd/<name>   -> /dev/mtdN
#   /dev/block/<name> -> /dev/mtdblockN
# plus active-slot aliases (<name> for <name>_<slot>) when the bootloader
# passes bootslot=a|b on the kernel cmdline (UNVERIFIED on this unit, P0).

START=10
USE_PROCD=1

mt6890_link() {
	# $1 = target, $2 = link
	[ -e "$1" ] || return 0
	[ -L "$2" ] && [ "$(readlink "$2")" = "$1" ] && return 0
	rm -f "$2"
	ln -s "$1" "$2"
}

mt6890_slot() {
	local arg
	for arg in $(cat /proc/cmdline); do
		case "$arg" in
		bootslot=a|bootslot=b) echo "${arg#bootslot=}"; return 0 ;;
		esac
	done
	return 1
}

mt6890_make_links() {
	local dev size erase name num slot base

	[ -r /proc/mtd ] || return 0
	mkdir -p /dev/mtd /dev/block
	slot="$(mt6890_slot)"

	# mtdN: 00100000 00040000 "name"
	while read -r dev size erase name; do
		case "$dev" in
		mtd[0-9]*:) ;;
		*) continue ;;
		esac
		num="${dev#mtd}"
		num="${num%:}"
		name="${name#\"}"
		name="${name%\"}"
		[ -n "$name" ] || continue
		case "$name" in
		*/*|.|..) continue ;;
		esac

		mt6890_link "/dev/mtd$num" "/dev/mtd/$name"
		mt6890_link "/dev/mtdblock$num" "/dev/block/$name"

		if [ -n "$slot" ]; then
			case "$name" in
			*_"$slot")
				base="${name%_"$slot"}"
				mt6890_link "/dev/mtd$num" "/dev/mtd/$base"
				mt6890_link "/dev/mtdblock$num" "/dev/block/$base"
				;;
			esac
		fi
	done < /proc/mtd
}

start_service() {
	mt6890_make_links
}

boot() {
	mt6890_make_links
}
